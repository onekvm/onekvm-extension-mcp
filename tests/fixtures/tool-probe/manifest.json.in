{
  "manifest_version": 1,
  "api_version": 2,
  "id": "mcp-tool-probe",
  "version": "@VERSION@",
  "architecture": "@ARCH@",
  "i18n": {"default": {"name": "MCP tool probe", "description": "Temporary MCP tool access acceptance fixture."}},
  "kind": "service",
  "permissions": [],
  "capabilities": [],
  "settings_schema": {"type": "object", "additionalProperties": false, "properties": {}},
  "secret_fields": [],
  "methods": [{"name": "status", "command": ["bin/probe"], "timeout_seconds": 3}],
  "contributions": [{
    "point": "extend.mcp", "id": "status", "version": 1, "method": "status",
    "data": {"description": "Read the probe invocation counter.", "inputSchema": {"type": "object", "additionalProperties": false, "properties": {}}}
  }],
  "healthcheck": {"type": "exec", "command": ["bin/probe", "--health"], "timeout_seconds": 3},
  "resource_limits": {"memory_max": "8M", "cpu_quota": "5%", "tasks_max": 8, "limit_nofile": 32}
}
