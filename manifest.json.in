{
  "manifest_version": 1,
  "id": "mcp",
  "i18n": {
    "default": {"name": "MCP", "description": "Lets authenticated AI agents capture the OneKVM screen and operate input and available ATX controls through MCP."},
    "zh": {"name": "MCP", "description": "让经过鉴权的 AI Agent 通过 MCP 截取 OneKVM 屏幕并操作输入设备和可用的 ATX 控制。"},
    "zh-TW": {"name": "MCP", "description": "讓經過鑑權的 AI Agent 透過 MCP 擷取 OneKVM 螢幕並操作輸入裝置和可用的 ATX 控制。"}
  },
  "version": "@VERSION@",
  "api_version": 2,
  "architecture": "@ARCH@",
  "kind": "service",
  "author": "OneKVM",
  "homepage": "https://github.com/onekvm/onekvm-extension-mcp",
  "entrypoint": "bin/onekvm-mcp",
  "permissions": ["network", "network-info"],
  "capabilities": ["video.mjpeg", "hid", "atx"],
  "services": [{
    "id": "server",
    "i18n": {
      "default": {"name": "MCP server", "description": "Accepts AI assistants that present the access token."},
      "zh": {"name": "MCP 服务", "description": "供持有访问令牌的 AI 助手连接。"},
      "zh-TW": {"name": "MCP 服務", "description": "供持有存取權杖的 AI 助手連線。"}
    }
  }],
  "icon": {"source": "lucide", "name": "bot"},
  "page": {"title": "MCP", "renderer": "vue", "entrypoint": "web/page.js", "icon": {"source": "lucide", "name": "bot"}},
  "routes": [{"path": "", "backend": "unix", "socket": "mcp.sock", "auth": "passthrough"}],
  "settings_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["endpoint", "listen_mode", "port", "capture_timeout_seconds"],
    "properties": {
      "endpoint": {"type": "string", "title": "MCP endpoint", "default": "/plugins/mcp", "maxLength": 64, "readOnly": true, "i18n": {"default": "MCP endpoint", "zh": "MCP 端点", "zh-TW": "MCP 端點"}},
      "listen_mode": {"type": "string", "title": "Listen interface", "enum": ["all", "interface", "address"], "default": "all", "i18n": {"default": "Listen interface", "zh": "监听接口", "zh-TW": "監聽介面"}},
      "listen_interface": {"type": "string", "title": "Interface", "default": "", "maxLength": 15, "enabled_when": {"field": "listen_mode", "equals": "interface"}, "required_when": {"field": "listen_mode", "equals": "interface"}, "i18n": {"default": "Interface", "zh": "接口", "zh-TW": "介面"}},
      "listen_address": {"type": "string", "title": "IP address", "default": "", "maxLength": 64, "enabled_when": {"field": "listen_mode", "equals": "address"}, "required_when": {"field": "listen_mode", "equals": "address"}, "i18n": {"default": "IP address", "zh": "IP 地址", "zh-TW": "IP 位址"}},
      "port": {"type": "integer", "title": "Port", "default": 9710, "minimum": 1024, "maximum": 65535, "i18n": {"default": "Port", "zh": "端口", "zh-TW": "連接埠"}},
      "access_token": {"type": "string", "title": "Access token (at least 16 characters)", "format": "password", "default": "", "maxLength": 128, "i18n": {"default": "Access token (at least 16 characters)", "zh": "访问令牌（至少 16 个字符）", "zh-TW": "存取權杖（至少 16 個字元）"}},
      "capture_timeout_seconds": {"type": "integer", "title": "Screen capture timeout (seconds)", "default": 5, "minimum": 1, "maximum": 15, "i18n": {"default": "Screen capture timeout (seconds)", "zh": "屏幕截图超时（秒）", "zh-TW": "螢幕擷取逾時（秒）"}}
    }
  },
  "secret_fields": ["/access_token"],
  "memory_budget": "4M",
  "resource_limits": {"memory_max": "16M", "cpu_quota": "20%", "tasks_max": 4, "limit_nofile": 32},
  "healthcheck": {"type": "exec", "command": ["bin/onekvm-mcp", "--health"], "timeout_seconds": 5}
}
